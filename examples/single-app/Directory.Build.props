<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <!-- A standalone org repo in miniature (what `dotnet new cohesion-app -n Acme` writes): its own identity and the one
       application every resource in this repo belongs to. -->
  <PropertyGroup>
    <CohesionOrganization>acme</CohesionOrganization>
    <CohesionApplication>acme</CohesionApplication>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>
</Project>
