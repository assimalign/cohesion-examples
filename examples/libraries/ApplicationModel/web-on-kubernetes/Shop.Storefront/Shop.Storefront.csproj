<Project Sdk="Assimalign.Cohesion.Sdk.Web">
	<PropertyGroup>
		<!-- dotnet publish -t:PublishContainer (publish-images.ps1) builds the resource's image. -->
		<EnableSdkContainerSupport>true</EnableSdkContainerSupport>
		<ContainerRepository>shop-storefront</ContainerRepository>
		<ContainerImageTag>latest</ContainerImageTag>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Assimalign.Cohesion.ApplicationModel.Hosting.Kubernetes" Version="$(CohesionPlatformsVersion)" />
	</ItemGroup>
</Project>
