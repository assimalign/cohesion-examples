<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    No credential values, ever: the block below names environment variables only.
    Assimalign.Cohesion.* resolves from the Assimalign GitHub Packages feed, where cohesion's CI publishes the SDKs,
    the fabric packages and the area providers, and cohesion-platforms' CI publishes Fabric.Kubernetes and
    Fabric.Kubernetes.Drivers. global.json and Directory.Build.props pin which builds. GitHub Packages needs a token
    with read:packages even for reads. Supply it per developer, outside this file, through GITHUB_USERNAME and
    GITHUB_PASSWORD, or through NuGet's own variable:
      NuGetPackageSourceCredentials_assimalign = Username=<github-user>;Password=<token>
  -->
  <packageSources>
    <clear />
    <add key="assimalign" value="https://nuget.pkg.github.com/assimalign/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="assimalign">
      <package pattern="Assimalign.Cohesion.*" />
      <package pattern="Assimalign.Viu.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <assimalign>
      <add key="Username" value="%GITHUB_USERNAME%" />
      <add key="ClearTextPassword" value="%GITHUB_PASSWORD%" />
    </assimalign>
  </packageSourceCredentials>
</configuration>
