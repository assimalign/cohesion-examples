<Project Sdk="Assimalign.Cohesion.Sdk.Application">
	<ItemGroup>
		<PackageReference Include="Assimalign.Cohesion.Fabric.Kubernetes" Version="$(CohesionPlatformsVersion)" />
		<!-- One package per provider: app.LogSpace, app.ConfigurationStore and app.MessageHub. [proposed] v2 as it
		     stood ran these three as plain workloads with volumes of their own and had no provider for them. -->
		<PackageReference Include="Assimalign.Cohesion.LogSpace.ResourceProvider" Version="$(CohesionVersion)" />
		<PackageReference
			Include="Assimalign.Cohesion.ConfigurationStore.ResourceProvider" Version="$(CohesionVersion)" />
		<PackageReference Include="Assimalign.Cohesion.MessageHub.ResourceProvider" Version="$(CohesionVersion)" />
		<!-- Needed to name another application's IdentityHub with a type: identityApp.IdentityHub.Get("identity"). -->
		<PackageReference Include="Assimalign.Cohesion.IdentityHub.ResourceProvider" Version="$(CohesionVersion)" />
	</ItemGroup>
	<ItemGroup>
		<!-- Add<Projects.X>(…): the programs this application runs. -->
		<ProjectReference Include="..\..\BookStore.Platform.LogSpace\src\BookStore.Platform.LogSpace.csproj" />
		<ProjectReference
			Include="..\..\BookStore.Platform.ConfigurationStore\src\BookStore.Platform.ConfigurationStore.csproj" />
		<ProjectReference Include="..\..\BookStore.Platform.MessageHub\src\BookStore.Platform.MessageHub.csproj" />
	</ItemGroup>
	<ItemGroup>
		<!-- [proposed] localStandIn: Projects.BookStore_Identity_AppHost, the local stand-in for the identity
		     application. -->
		<ProjectReference
			Include="..\..\..\Identity\BookStore.Identity.AppHost\src\BookStore.Identity.AppHost.csproj" />
	</ItemGroup>
</Project>
