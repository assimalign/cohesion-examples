<Project Sdk="Assimalign.Cohesion.Sdk.Application">
	<ItemGroup>
		<PackageReference Include="Assimalign.Cohesion.Fabric.Kubernetes" Version="$(CohesionPlatformsVersion)" />
		<!-- The app.Web section. [proposed] Web.ResourceProvider: v2 as it stood ran a web program as a plain
		     workload. -->
		<PackageReference Include="Assimalign.Cohesion.Web.ResourceProvider" Version="$(CohesionVersion)" />
		<!-- Needed to name another application's resources with a type: identityApp.IdentityHub.Get("identity"),
		     platformApp.LogSpace.Get("logs") and platformApp.ConfigurationStore.Get("config"). -->
		<PackageReference Include="Assimalign.Cohesion.IdentityHub.ResourceProvider" Version="$(CohesionVersion)" />
		<PackageReference Include="Assimalign.Cohesion.LogSpace.ResourceProvider" Version="$(CohesionVersion)" />
		<PackageReference
			Include="Assimalign.Cohesion.ConfigurationStore.ResourceProvider" Version="$(CohesionVersion)" />
	</ItemGroup>
	<ItemGroup>
		<!-- Add<Projects.BookStore_Storefront_Host>(…): the program this application runs. -->
		<ProjectReference Include="..\..\BookStore.Storefront.Host\src\BookStore.Storefront.Host.csproj" />
	</ItemGroup>
	<ItemGroup>
		<!-- [proposed] localStandIn: Projects.X, the local stand-ins. -->
		<ProjectReference
			Include="..\..\..\..\Identity\BookStore.Identity.AppHost\src\BookStore.Identity.AppHost.csproj" />
		<ProjectReference
			Include="..\..\..\..\Platform\BookStore.Platform.AppHost\src\BookStore.Platform.AppHost.csproj" />
		<ProjectReference
			Include="..\..\..\..\Networking\BookStore.Networking.AppHost\src\BookStore.Networking.AppHost.csproj" />
	</ItemGroup>
</Project>
