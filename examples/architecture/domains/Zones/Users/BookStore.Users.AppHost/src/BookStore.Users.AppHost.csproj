<Project Sdk="Assimalign.Cohesion.Sdk.Application">
	<ItemGroup>
		<PackageReference Include="Assimalign.Cohesion.Fabric.Kubernetes" Version="$(CohesionPlatformsVersion)" />
		<!-- A provider package ships its section (app.Database, app.Web), its declaration and resource types with their
		     outputs, its roles, and the validators the ResourceManager runs at admission. One package per provider.
		     [proposed] Web.ResourceProvider: v2 as it stood ran a web program as a plain workload. -->
		<PackageReference Include="Assimalign.Cohesion.Database.ResourceProvider" Version="$(CohesionVersion)" />
		<PackageReference Include="Assimalign.Cohesion.Web.ResourceProvider" Version="$(CohesionVersion)" />
		<!-- Needed to name another application's resources with a type: identityApp.IdentityHub.Get("identity") and
		     platformApp.LogSpace.Get("logs"). -->
		<PackageReference Include="Assimalign.Cohesion.IdentityHub.ResourceProvider" Version="$(CohesionVersion)" />
		<PackageReference Include="Assimalign.Cohesion.LogSpace.ResourceProvider" Version="$(CohesionVersion)" />
	</ItemGroup>
	<ItemGroup>
		<!-- Add<Projects.X>(…): the programs this application runs. Sdk.Application generates one type under
		     Projects for each referenced program, and a value for each AppHost project referenced below, and
		     `cohesion deploy` publishes each program as an image. -->
		<ProjectReference Include="..\..\BookStore.Users.Api\src\BookStore.Users.Api.csproj" />
		<ProjectReference Include="..\..\BookStore.Users.Database\src\BookStore.Users.Database.csproj" />
	</ItemGroup>
	<ItemGroup>
		<!-- [proposed] localStandIn: Projects.X is another application's AppHost, applied as a stand-in in local
		     runs only. -->
		<ProjectReference
			Include="..\..\..\..\Identity\BookStore.Identity.AppHost\src\BookStore.Identity.AppHost.csproj" />
		<ProjectReference
			Include="..\..\..\..\Platform\BookStore.Platform.AppHost\src\BookStore.Platform.AppHost.csproj" />
		<ProjectReference
			Include="..\..\..\..\Networking\BookStore.Networking.AppHost\src\BookStore.Networking.AppHost.csproj" />
	</ItemGroup>
</Project>
