<Project Sdk="Microsoft.NET.Sdk">
	<!-- Tests for the document, not for a deployment: they emit each platform's view and assert on it. No cluster,
	     no RM. -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
		<EnableSdkContainerSupport>false</EnableSdkContainerSupport>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Assimalign.Cohesion.Fabric.Testing" Version="$(CohesionVersion)" />
		<PackageReference Include="xunit.v3" Version="3.0.0" />
		<PackageReference Include="Shouldly" Version="4.3.0" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\src\BookStore.Users.AppHost.csproj" />
	</ItemGroup>
</Project>
