<Project Sdk="Assimalign.Cohesion.Sdk.Gateway">
  <!--
    One Sdk.Gateway project = one application = one deployment unit = one namespace (appc). A gateway always has
    CohesionApplicationModel enabled (it is itself a resource with a manifest and a control plane). Sdk.Gateway injects the
    orchestration packages, walks the referenced manifests transitively (stopping at application boundaries), and generates
    Gateway.g.cs: Gateway.CreateBuilder(args), one AddAppCApi/Spa/Database/SecretStore verb per referenced member (the
    gateway names what it composes; there is no AddAllResources), and Externals.IdentityHub / Externals.PlatformConfigurationStore
    for the crossings the Api declares. Sdk.Gateway injects an area's ApplicationModel package only for the areas of the
    referenced resource projects (Web, Database, SecretStore here); the ConfigurationStore package the remote binder needs
    is this project's own explicit reference below.
  -->
  <PropertyGroup>
    <CohesionApplicationName>appc</CohesionApplicationName>
    <!-- A gateway is always enabled by Sdk.Gateway. -->
    <CohesionGateways>Local;InProcess;Docker;Kubernetes</CohesionGateways>
    <!-- Platforms ship without the Cohesion SDK feed's .local suffix. -->
    <CohesionPlatformsVersion>10.0.0-preview.1</CohesionPlatformsVersion>
    <CohesionGatewayInProcess>true</CohesionGatewayInProcess>                <!-- sanctioned composition root: the in-process gateway runs every resource's entry in this process under its own ResourceContext -->
  </PropertyGroup>
  <ItemGroup>
    <CohesionResourceReference Include="..\Example.AppC.Api\Example.AppC.Api.csproj" />
    <CohesionResourceReference Include="..\Example.AppC.Spa\Example.AppC.Spa.csproj" />
    <!-- InProcess needs a compile-time entry anchor for each composable member, including transitive members. -->
    <CohesionResourceReference Include="..\Example.AppC.Database\Example.AppC.Database.csproj" />
    <CohesionResourceReference Include="..\Example.AppC.SecretStore\Example.AppC.SecretStore.csproj" />
    <!-- Consumed across the platform boundary through Externals.PlatformConfigurationStore; no referenced project carries this area. -->
    <CohesionPackageReference Include="Assimalign.Cohesion.ConfigurationStore.ApplicationModel" Version="$(CohesionVersion)" />
    <Content Include="Configuration\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
