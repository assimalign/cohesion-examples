<Project Sdk="Assimalign.Cohesion.Sdk.ConfigurationStore">
  <!-- The platform configuration resource is an ordinary executable whose Program.cs seeds the networking
       namespace; its gateway seeds shared. Consumers reach it through the gateway's mount resolution
       (`platform-configuration-store:<key>`) or the ConfigurationStore.Client at run time. Zone namespaces are not declared
       here: each zone claims its own with a `config.AddNamespace(...)` command from its gateway.
       Default control plane commands: configurationstore.add-namespace, configurationstore.set-value, configurationstore.remove-value.
       Sdk.ConfigurationStore defaults: endpoint `api` (https 8443, private, Certificate=tls), mount `tls` (Secret), mount `data` (Volume, 10Gi), StatefulSet, replicas 1. -->
  <PropertyGroup>
    <CohesionResourceName>platform-configuration-store</CohesionResourceName>
    <!-- Opt-in to orchestration. Enabled: Sdk.ConfigurationStore generates resource.json (the manifest), Resource.g.cs (typed accessors:
         Resource.Endpoints/Mounts/Settings/References over the ambient ResourceContext) and ResourceControlPlane.g.cs (the
         ConfigurationStore default control plane — readiness, health, observed endpoints, stop, ConfigurationStore commands — owned by
         ConfigurationStore.ApplicationModel). Disabled (the default): a plain executable that no gateway can reference. -->
    <CohesionApplicationModel>enabled</CohesionApplicationModel>
  </PropertyGroup>
  <ItemGroup>
    <CohesionEndpoint Update="api" Public="true" Certificate="tls" />
    <CohesionMount Update="tls" Source="platform-secretstore:certs/platform-configuration-store" />
    <CohesionResourceReference Include="..\Example.Platform.SecretStore\Example.Platform.SecretStore.csproj" />
    <Content Include="Configuration\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
