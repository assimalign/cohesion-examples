<Project Sdk="Assimalign.Cohesion.Sdk.Gateway">
  <!--
    One Sdk.Gateway project = one application = one deployment unit = one namespace (appa). A gateway always has
    CohesionApplicationModel enabled (it is itself a resource with a manifest and a control plane). Sdk.Gateway injects the
    orchestration core, walks the referenced manifests transitively (stopping at application boundaries), and generates
    Gateway.g.cs: Gateway.CreateBuilder(args), Manifests.AppAApi/Spa/Database/SecretStore for the referenced members, and
    Externals.IdentityHub / Externals.PlatformConfigurationStore for the crossings the Api declares. There is no generated
    Add<Member> verb: Program.cs composes each member with its area's hand-written verb over its manifest, for example
    builder.AddWeb(Manifests.AppAApi). Sdk.Gateway injects an area's ApplicationModel package only for the areas of the
    referenced resource projects (Web, Database, SecretStore here) and injects no client or provider package; the
    ConfigurationStore package the remote binder needs and the SecretStore orchestration providers are this project's own
    explicit references below.
  -->
  <PropertyGroup>
    <CohesionApplicationName>appa</CohesionApplicationName>
    <!-- A gateway is always enabled by Sdk.Gateway. -->
    <CohesionGateways>Local;InProcess;Docker;Kubernetes</CohesionGateways>
    <!-- Platforms ship without the Cohesion SDK feed's .local suffix. -->
    <CohesionPlatformsVersion>10.0.0-preview.1</CohesionPlatformsVersion>
    <CohesionGatewayInProcess>true</CohesionGatewayInProcess>                <!-- sanctioned composition root: the in-process gateway runs every resource's entry in this process under its own ResourceContext -->
  </PropertyGroup>
  <ItemGroup>
    <CohesionResourceReference Include="..\Example.AppA.Api\Example.AppA.Api.csproj" />
    <CohesionResourceReference Include="..\Example.AppA.Spa\Example.AppA.Spa.csproj" />
    <!-- InProcess needs a compile-time entry anchor for each composable member, including transitive members. -->
    <CohesionResourceReference Include="..\Example.AppA.Database\Example.AppA.Database.csproj" />
    <CohesionResourceReference Include="..\Example.AppA.SecretStore\Example.AppA.SecretStore.csproj" />
    <!-- Consumed across the platform boundary through Externals.PlatformConfigurationStore; no referenced project carries this area. -->
    <CohesionPackageReference Include="Assimalign.Cohesion.ConfigurationStore.ApplicationModel" Version="$(CohesionVersion)" />
    <!-- Opt-in gateway providers, registered in Program.cs: builder.UseSecretStore(secrets).AsCertificateAuthority().AsTrustStore(). -->
    <CohesionPackageReference Include="Assimalign.Cohesion.SecretStore.ApplicationModel.Orchestration" Version="$(CohesionVersion)" />
    <Content Include="Configuration\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
