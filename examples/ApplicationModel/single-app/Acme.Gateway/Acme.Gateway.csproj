<Project Sdk="Assimalign.Cohesion.Sdk.Gateway">
  <PropertyGroup>
    <CohesionApplicationName>acme</CohesionApplicationName>
    <!-- A gateway is always enabled by Sdk.Gateway. -->
    <CohesionGateways>Local;InProcess;Docker;Kubernetes</CohesionGateways>
    <!-- Platforms ship without the Cohesion SDK feed's .local suffix. -->
    <CohesionPlatformsVersion>10.0.1-preview.3</CohesionPlatformsVersion>
    <CohesionGatewayInProcess>true</CohesionGatewayInProcess>
  </PropertyGroup>
  <ItemGroup>
    <CohesionResourceReference Include="..\Acme.Api\Acme.Api.csproj" />
    <!-- InProcess needs a compile-time entry anchor for each composable member, including transitive members. -->
    <CohesionResourceReference Include="..\Acme.Database\Acme.Database.csproj" />
  </ItemGroup>
</Project>
