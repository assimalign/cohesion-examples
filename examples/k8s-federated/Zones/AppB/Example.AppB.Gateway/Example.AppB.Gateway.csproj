<Project Sdk="Assimalign.Cohesion.Sdk.Gateway">
  <!--
    One Sdk.Gateway project = one application = one deployment unit = one namespace (appb). A gateway always has
    CohesionApplicationModel enabled (it is itself a resource with a manifest and a control plane). Sdk.Gateway injects the
    orchestration packages, walks the referenced manifests transitively (stopping at application boundaries), and generates
    Resources.g.cs: Gateway.CreateBuilder(args), AddAppBApi/Spa/Database/SecretStore, AddAllResources, and
    Externals.IdentityHub / Externals.PlatformConfigurationStore for the crossings the Api declares.
  -->
  <PropertyGroup>
    <CohesionApplicationName>appb</CohesionApplicationName>
    <CohesionGateways>Local;InProcess;Docker;Kubernetes</CohesionGateways>   <!-- Kubernetes flows RequiresJit → this executable is JIT; keep a Local-only gateway project if an AOT gateway matters -->
    <CohesionGatewayInProcess>true</CohesionGatewayInProcess>                <!-- sanctioned composition root: `--gateway inprocess` runs every resource's entry in this process under its own ResourceContext -->
  </PropertyGroup>
  <ItemGroup>
    <!-- Roots only; Database and SecretStore arrive transitively through the Api's references. -->
    <CohesionResourceReference Include="..\Example.AppB.Api\Example.AppB.Api.csproj" />
    <CohesionResourceReference Include="..\Example.AppB.Spa\Example.AppB.Spa.csproj" />
    <!-- A gateway-level crossing into `networking` (generated as Externals.NetworkingRezolvr), used only for the development DNS record command. -->
    <CohesionResourceReference Include="..\..\..\Networking\Example.Networking.Rezolvr\Example.Networking.Rezolvr.csproj" Optional="true" />
    <Content Include="Configuration\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
