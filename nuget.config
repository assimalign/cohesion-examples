<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    No credential values, ever: the block below names environment variables only, and credential-guard.yml
    fails the build on any other password value or any token in a tracked file.
    Assimalign.Cohesion.* resolves from the Assimalign GitHub Packages feed, where cohesion's CI publishes
    every main build (10.0.0-preview.0.ci.<run>) and pull request build (10.0.0-preview.0.pr.<pr>.<run>), and
    cohesion-platforms' CI publishes its own; global.json and each ApplicationModel example's
    Directory.Build.props pin which ones. GitHub Packages needs a token with read:packages even for reads.
    Supply it per developer, outside this file, through GITHUB_USERNAME and GITHUB_PASSWORD (below), or
    through NuGet's own variable:
      NuGetPackageSourceCredentials_assimalign = Username=<github-user>;Password=<token>
  -->
  <packageSources>
    <clear />
    <add key="assimalign" value="https://nuget.pkg.github.com/assimalign/index.json" />
    <!-- Everything that is not an Assimalign package (BCL facades, runtime packs, the Kubernetes client). -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="assimalign">
      <package pattern="Assimalign.Cohesion.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <assimalign>
      <add key="Username" value="%GITHUB_USERNAME%" />
      <add key="ClearTextPassword" value="%GITHUB_PASSWORD%" />
    </assimalign>
  </packageSourceCredentials>
</configuration>
