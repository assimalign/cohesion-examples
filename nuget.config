<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    No credentials, ever (credential-guard.yml fails the build on any credential block or token in a tracked file).
    Assimalign.Cohesion.* resolves from the Assimalign GitHub Packages feed, where cohesion's CI publishes
    every main build (10.0.0-preview.0.ci.<run>) and pull request build (10.0.0-preview.0.pr.<pr>.<run>);
    global.json pins which one. GitHub Packages needs a token with read:packages even for reads. Supply it
    per developer, outside this file, for example through the environment:
      NuGetPackageSourceCredentials_assimalign = Username=<github-user>;Password=<token>
    The org's own feed (Example.*.Manifest packages published by other repos, e.g. Example.AppA.Worker.Manifest) is mapped below.
  -->
  <packageSources>
    <clear />
    <add key="assimalign" value="https://nuget.pkg.github.com/assimalign/index.json" />
    <!-- Everything that is not an Assimalign or Example package (BCL facades, runtime packs, the Kubernetes client). -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="example" value="https://nuget.pkg.github.com/example/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="assimalign">
      <package pattern="Assimalign.Cohesion.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="example">
      <package pattern="Example.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
