<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    No credentials, ever (credential-guard.yml fails the build on any credential block or token in a tracked file).
    Assimalign.Cohesion.* resolves from nuget.org once a preview is promoted. During a beta window add the
    GitHub Packages staging feed per developer, outside this file:
      dotnet nuget add source https://nuget.pkg.github.com/assimalign/index.json -n cohesion-staging -u USER -p (gh auth token) --store-password-in-clear-text
    The org's own feed (Example.*.Manifest packages published by other repos, e.g. Example.AppA.Worker.Manifest) is mapped below.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="example" value="https://nuget.pkg.github.com/example/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="Assimalign.Cohesion.*" />
      <package pattern="*" />
    </packageSource>
    <packageSource key="example">
      <package pattern="Example.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
