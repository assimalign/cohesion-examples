<Project>
  <!--
    Identity only. The Cohesion SDKs set OutputType, TargetFramework, LangVersion, preview features and ImplicitUsings
    themselves; nothing build-shaped belongs here. Per-area Directory.Build.props files under examples/k8s/ and
    examples/k8s-federated/ (Identity/, Networking/, Platform/, Zones/<App>/) import this file and set CohesionApplication
    once for every resource in their folder; examples/single-app/ is a self-contained org repo and does not import it.
  -->
  <PropertyGroup>
    <CohesionOrganization>example</CohesionOrganization>                 <!-- image repository prefix: example/<resource-name> -->
    <CohesionContainerRegistry>ghcr.io/example</CohesionContainerRegistry> <!-- empty = OCI archive on disk only -->
    <VersionPrefix>1.4.0</VersionPrefix>
  </PropertyGroup>
</Project>
